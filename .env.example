# Copy to .env. Every setting the service reads is listed here. No real secrets belong in this file.
POSTGRES_PASSWORD=music
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=incubrix-music
S3_REGION=us-east-1
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000   # host used in download links (must be reachable by the client)
LINK_EXPIRY_S=86400
PUBLIC_BASE_URL=http://localhost:8000
MUSIC_PROVIDER=procedural                       # procedural | mock | flaky
FALLBACK_PROVIDER=                              # e.g. procedural, used when the primary provider fails or times out
PROVIDER_FAIL_MODE=error                        # only for the 'flaky' demo provider: error | timeout
JOB_TIMEOUT_S=600
API_TOKEN=                                      # empty = no auth; set to require "Authorization: Bearer <token>"
RATE_LIMIT_PER_MIN=120
CALLBACK_SECRET=change-me
WORKER_CONCURRENCY=2
WORKER_POLL_S=0.5
MAX_UPLOAD_MB=60
LOG_LEVEL=INFO
# Local (non-docker) runs only:
# DATABASE_URL=sqlite:///./data/app.db
# STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=./data/files
